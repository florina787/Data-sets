# CloudNova Copilot configuration. Copy to .env. No secrets are required.
# ---- data
CLOUDNOVA_RAW_CSV=data/raw/cloudnova_invoices.csv
CLOUDNOVA_DATA_DIR=data/processed
CLOUDNOVA_RUNTIME_DIR=data/runtime
# ---- business rules (from BUSINESS_CONTEXT.md; fixed for this exercise)
FX_EUR_USD=1.08
FX_GBP_USD=1.27
# documented = amount_local * rate (BUSINESS_CONTEXT); inverse = amount_local / rate (see specs §6 open question)
FX_DIRECTION=documented
# ---- local LLM (Qwen via any OpenAI-compatible server: Ollama, llama.cpp, vLLM, LM Studio)
LLM_PROVIDER=qwen            # qwen | none
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5-coder:3b
LLM_TIMEOUT_S=90
LLM_MAX_TOKENS=512
# hybrid = approved metric catalog first, Qwen text-to-SQL fallback (default) · llm = Qwen SQL for every data question (comparison)
QUERY_MODE=hybrid
# ---- governance / limits
MAX_RESULT_ROWS=200
QUERY_TIMEOUT_S=10
DUCKDB_MEMORY_LIMIT=1GB
ALLOW_PII=false
# ---- startup (python -m app)
CLOUDNOVA_HOST=127.0.0.1
CLOUDNOVA_PORT=8000
# Optional: command that starts your local Qwen server if LLM_BASE_URL is not answering. It is started by
# `python -m app`, health-checked, and stopped on shutdown. Leave empty if Qwen is already running (e.g. Ollama app).
# Ollama:     LLM_START_CMD=ollama serve            (model must already be pulled: ollama pull qwen2.5-coder:3b)
# llama.cpp:  LLM_START_CMD=python -m llama_cpp.server --model /path/qwen2.5-coder-3b-instruct-q4_k_m.gguf --model_alias qwen2.5-coder:3b --port 11434
LLM_START_CMD=
LLM_START_TIMEOUT_S=120
# ---- policy decisions (Decisions page). Empty = approvals disabled. Demo-grade control: a shared PIN, not SSO.
FINANCE_APPROVER_PIN=
