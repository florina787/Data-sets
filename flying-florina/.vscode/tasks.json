{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flying Florina: setup (run once)",
      "type": "shell",
      "command": "sh scripts/setup.sh",
      "windows": { "command": "powershell -ExecutionPolicy Bypass -File scripts\\setup.ps1" },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Flying Florina: backend (API :8000)",
      "type": "shell",
      "command": ".venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000",
      "windows": { "command": ".\\.venv\\Scripts\\python -m uvicorn app.main:app --host 127.0.0.1 --port 8000" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": { "owner": "uvicorn", "pattern": { "regexp": "^x" }, "background": { "activesBegin": true, "beginsPattern": "Started server process", "endsPattern": "ready" } },
      "presentation": { "group": "ff", "panel": "dedicated" }
    },
    {
      "label": "Flying Florina: frontend (UI :5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": { "owner": "vite", "pattern": { "regexp": "^x" }, "background": { "activesBegin": true, "beginsPattern": "VITE", "endsPattern": "Local:" } },
      "presentation": { "group": "ff", "panel": "dedicated" }
    },
    {
      "label": "Flying Florina: run app",
      "dependsOn": ["Flying Florina: backend (API :8000)", "Flying Florina: frontend (UI :5173)"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Flying Florina: check local Qwen",
      "type": "shell",
      "command": ".venv/bin/python ../scripts/check_qwen.py",
      "windows": { "command": ".\\.venv\\Scripts\\python ..\\scripts\\check_qwen.py" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Flying Florina: backend tests",
      "type": "shell",
      "command": ".venv/bin/python -m pytest -q",
      "windows": { "command": ".\\.venv\\Scripts\\python -m pytest -q" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
