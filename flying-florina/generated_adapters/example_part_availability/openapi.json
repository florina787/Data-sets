{
 "openapi": "3.1.0",
 "info": {
  "title": "Part Availability Adapter (synthetic)",
  "version": "1.0.0",
  "description": "Bundle BRG-fd309e1d1649"
 },
 "paths": {
  "/v1/parts/{part_number}/availability": {
   "get": {
    "operationId": "get_part_availability",
    "security": [
     {
      "bearer": [
       "inventory.read"
      ]
     }
    ],
    "parameters": [
     {
      "name": "part_number",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^P-[0-9A-Z]{3,8}$"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Availability"
     },
     "401": {
      "description": "Unauthorized"
     },
     "403": {
      "description": "Forbidden"
     },
     "404": {
      "description": "Unknown part"
     }
    }
   }
  },
  "/v1/parts": {
   "get": {
    "operationId": "list_parts",
    "parameters": [
     {
      "name": "limit",
      "in": "query",
      "schema": {
       "type": "integer",
       "maximum": 50
      }
     },
     {
      "name": "offset",
      "in": "query",
      "schema": {
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Page"
     }
    }
   }
  },
  "/healthz": {
   "get": {
    "operationId": "healthz",
    "responses": {
     "200": {
      "description": "OK"
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer"
   }
  }
 }
}