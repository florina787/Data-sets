# Flying_Florina - example configuration. Copy to .env if you want to override defaults.
# Never commit real secrets. All defaults are the safe offline synthetic demo.
DEMO_MODE=true
OFFLINE_MODE=true
# Optional local LLM (loopback only, POL-008). It may rephrase text; it never decides policy.
LLM_ENABLED=false
LLM_URL=http://127.0.0.1:11434
LLM_MODEL=
# Set only for licensed brand assets placed in frontend/public/brand/
BRAND_ASSETS_AUTHORIZED=false
# Optional overrides
# FF_DATA_DIR=backend/data
# FF_SESSION_SECRET=        # random per install if unset (stored in FF_DATA_DIR/.session_secret)
# FF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# FF_MAX_UPLOAD_BYTES=2097152
# FF_APPROVAL_TTL_SECONDS=14400
