# Flying_Florina - example configuration. Copy to .env if you want to override defaults.
# Never commit real secrets. All defaults are the safe offline synthetic demo.
DEMO_MODE=true
OFFLINE_MODE=true
# Local Qwen (your EXISTING model; never downloaded, never a cloud API; loopback only, POL-008).
# on = required (default), auto = use when found, off = never call a model.
LLM_ENABLED=on
# Point at your model if it is not in a standard place (Discovery also checks
# ../conversation-intelligence-copilot/data/models/, ~/models, ~/.cache/huggingface, LM Studio and Ollama):
# FF_QWEN_MODEL_PATH=/absolute/path/to/qwen2.5-1.5b-instruct-q4_k_m.gguf
# Or an Ollama / llama.cpp / LM Studio server on this machine:
LLM_URL=http://127.0.0.1:11434
LLM_MODEL=
# FF_QWEN_BASE_URL=http://127.0.0.1:8080
# Performance knobs (measured on your hardware in Evaluation & Observability):
# FF_QWEN_THREADS=7
# FF_QWEN_GPU_LAYERS=-1
# FF_QWEN_N_CTX=4096
# FF_QWEN_MAX_TOKENS=320
# FF_QWEN_TIMEOUT_S=45
# Set only for licensed brand assets placed in frontend/public/brand/
BRAND_ASSETS_AUTHORIZED=false
# Optional overrides
# FF_DATA_DIR=backend/data
# FF_SESSION_SECRET=        # random per install if unset (stored in FF_DATA_DIR/.session_secret)
# FF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# FF_MAX_UPLOAD_BYTES=2097152
# FF_APPROVAL_TTL_SECONDS=14400
