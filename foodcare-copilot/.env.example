# Copy to .env (never commit .env). DEMO mode needs none of these.

# Optional LIVE mode: an OpenAI-compatible model server that is ALREADY running on
# this computer (Ollama, LM Studio, llama.cpp llama-server, MLX). Nothing is downloaded.
# Ollama:    FOODCARE_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LM Studio: FOODCARE_LLM_BASE_URL=http://127.0.0.1:1234/v1
FOODCARE_LLM_BASE_URL=
# Exact name from `ollama list` or LM Studio, e.g. qwen2.5:7b-instruct
FOODCARE_LLM_MODEL=

# Limits for LIVE mode (protect CPU and RAM)
FOODCARE_LLM_CONCURRENCY=1
FOODCARE_LLM_QUEUE_SIZE=4
FOODCARE_LLM_TIMEOUT_S=60
FOODCARE_LLM_MAX_TOKENS=800
FOODCARE_LLM_MAX_PROMPT_CHARS=6000
# Use json_object or none if your server rejects JSON schemas
FOODCARE_LLM_RESPONSE_FORMAT=json_schema

# Potato inspection limits
FOODCARE_VISION_CONCURRENCY=1
FOODCARE_VISION_QUEUE_SIZE=2

# Ports and paths
FOODCARE_API_PORT=8700
FOODCARE_STOREFRONT_PORT=8801
# FOODCARE_VAR_DIR=/absolute/path/to/var

# Fixed demo clock inside the campaign window (America/Toronto, UTC-4 on this date)
FOODCARE_DEMO_CLOCK=2026-10-31T12:00:00-04:00
# Injected-fault delay in seconds
FOODCARE_FAULT_DELAY_S=4
