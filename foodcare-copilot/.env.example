# Copy to .env (never commit .env). DEMO mode needs none of these.

# Optional LIVE mode (Brief Analyst + Requirements Agent only). Both are required;
# no model is hardcoded. Use a current model identifier from the Anthropic docs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Limits for LIVE mode
FOODCARE_LLM_MAX_CALLS_PER_RUN=6
FOODCARE_LLM_MAX_TOKENS=4000
FOODCARE_LLM_TIMEOUT_S=60

# Ports and paths
FOODCARE_API_PORT=8700
FOODCARE_STOREFRONT_PORT=8801
# FOODCARE_VAR_DIR=/absolute/path/to/var

# Fixed demo clock inside the campaign window (America/Toronto, UTC-4 on this date)
FOODCARE_DEMO_CLOCK=2026-10-31T12:00:00-04:00
# Injected-fault delay in seconds
FOODCARE_FAULT_DELAY_S=4
