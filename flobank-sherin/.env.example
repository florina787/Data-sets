# Copy to backend/.env for local runs (or export). All optional.
DATABASE_URL=postgresql+psycopg://sherin:sherin@localhost:5432/flobank
# demo seeds clearly labelled synthetic data on first start; anything else starts empty
APP_MODE=demo
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_ENABLED=true
# Local inference cost model: amortised GPU/host cost and power draw
LOCAL_GPU_HOURLY_USD=1.10
LOCAL_POWER_KW=0.45
ELECTRICITY_USD_PER_KWH=0.16
