# Hugging Face Space configuration for Career_flo AI. NO VALUES HERE ARE REAL.
# "secret"   -> Space Settings → Secrets   (private; never shown again)
# "variable" -> Space Settings → Variables (public! only non-sensitive values)

# --- required ---------------------------------------------------------
DATABASE_URL=                 # secret   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
AUTH_MODE=supabase            # variable
SUPABASE_URL=                 # variable https://<ref>.supabase.co   (ES256 JWKS verification; no JWT secret needed)
VITE_SUPABASE_URL=            # variable same as SUPABASE_URL (build arg for the frontend)
VITE_SUPABASE_ANON_KEY=       # variable the *anon/publishable* key only (public by design; protected by RLS)
PUBLIC_APP_URL=               # variable https://<owner>-<space>.hf.space  (or your custom domain)
CORS_ORIGINS=                 # variable same origin as PUBLIC_APP_URL
ADMIN_EMAILS=                 # secret   comma-separated administrator emails

# --- payments (TEST MODE ONLY until launch is approved) -----------------
STRIPE_SECRET_KEY=            # secret   sk_test_...
STRIPE_WEBHOOK_SECRET=        # secret   whsec_... from the webhook endpoint https://<host>/api/webhooks/stripe
STRIPE_PRICE_PRO=             # variable price_...
STRIPE_PRICE_PREMIUM=         # variable price_...
STRIPE_ALLOW_LIVE=false       # variable must stay false until explicitly approved

# --- job providers (optional; without them demo jobs are shown, labelled synthetic) ---
JSEARCH_API_KEY=              # secret
ADZUNA_APP_ID=                # secret
ADZUNA_APP_KEY=               # secret
ENABLE_SYNTHETIC_JOBS=false   # variable set true only for a demo Space
GITHUB_TOKEN=                 # secret   optional, raises GitHub API rate limits

# --- inference (defaults run Qwen3-1.7B inside the container) ---------
# LLM_PROVIDER=llamacpp       # variable "hf" to use Inference Providers instead (then HF_TOKEN required)
# LLM_MODEL=qwen3-1.7b        # variable for "hf": e.g. Qwen/Qwen3.5-9B (smallest routable Qwen as of 2026-11)
# HF_TOKEN=                   # secret   fine-grained token, permission "Make calls to Inference Providers" only
# MODEL_REPO / MODEL_REVISION / MODEL_FILE / MODEL_SHA256 / MODEL_ALIAS   # variables (build args) to switch GGUF, e.g. 0.6B
INFRA_MONTHLY_COST_USD=9      # variable used by the ops dashboard's cost-per-user estimate
