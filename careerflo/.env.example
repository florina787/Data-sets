# ---- Core ------------------------------------------------------------
ENVIRONMENT=production
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
PUBLIC_APP_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
ADMIN_EMAILS=you@example.com

# ---- Auth (Supabase) -------------------------------------------------
AUTH_MODE=supabase
SUPABASE_URL=https://<project>.supabase.co
# Only for legacy HS256 projects; new projects use JWKS automatically:
SUPABASE_JWT_SECRET=
# Frontend (build args)
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# ---- Qwen (open-weight only) ----------------------------------------
LLM_MODEL=qwen3:1.7b

# ---- Job providers (verify each provider's terms before launch) -------
JSEARCH_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ENABLE_SYNTHETIC_JOBS=false
GITHUB_TOKEN=

# ---- Stripe: TEST MODE keys (sk_test_...) until live billing is approved ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PREMIUM=price_...
STRIPE_ALLOW_LIVE=false
