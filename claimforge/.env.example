# ClaimForge Copilot configuration. Copy to .env (git-ignored). Never commit real keys.
DEMO_MODE=true
# Only used when DEMO_MODE=false. Leave the placeholder for demo mode.
ANTHROPIC_API_KEY=your_own_key_here
ANTHROPIC_MODEL=claude-sonnet-5-5
RANDOM_SEED=42
# Per-agent loop bound (root-cause / remediation iterations, per-node re-invocation)
MAX_AGENT_ITERATIONS=8
# Per-agent-run tool-call budget
MAX_TOOL_CALLS=20
# Global LangGraph node budget per workflow run
MAX_WORKFLOW_STEPS=60
AGENT_TIMEOUT_SECONDS=30
DEFAULT_CLAIM_COUNT=10000
ANOMALY_RELATIVE_THRESHOLD=0.15
ANOMALY_Z_THRESHOLD=3.0
ANNUAL_CLAIM_VOLUME=250000
LOG_LEVEL=INFO
