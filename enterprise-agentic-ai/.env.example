# Copy to .env and adjust. NEVER commit your real .env file.

# --- Mode ------------------------------------------------------------------
# demo (default): no API key needed, zero paid LLM calls.
# live: uses Anthropic Claude; requires ANTHROPIC_API_KEY. For local/private use only.
APP_MODE=demo

# --- Anthropic (LIVE mode only) ---------------------------------------------
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5-5
# LLM_TEMPERATURE=  (leave unset; some models only accept the default)

# --- RAG ---------------------------------------------------------------------
# sentence-transformers (semantic, default) or hashing (lexical, offline, no downloads)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5

# --- Guardrails ----------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.45

# --- Uploads -------------------------------------------------------------------
ALLOW_UPLOADS=true
MAX_UPLOAD_MB=5

# --- Frontend --------------------------------------------------------------------
API_BASE_URL=http://localhost:8000

# --- Optional: LangSmith tracing (leave unset to disable) ------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_key_here
# LANGSMITH_PROJECT=enterprise-agentic-copilot

LOG_LEVEL=INFO
