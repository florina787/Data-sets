# LexGuard Copilot configuration. Copy to .env for local overrides. Never commit .env.
# DEMO_MODE=true needs no API key and makes zero paid LLM calls.
DEMO_MODE=true
DATABASE_URL=sqlite:///./lexguard.db
# PostgreSQL example: DATABASE_URL=postgresql+psycopg://lexguard:lexguard@db:5432/lexguard
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_AGENT_STEPS=12
MAX_TOOL_CALLS=40
REQUEST_TIMEOUT_S=20
# Optional live mode (DEMO_MODE=false). Used only to rephrase deterministic answers; never for controls.
ANTHROPIC_API_KEY=
LEXGUARD_LLM_MODEL=claude-sonnet-5-5
# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
