# FloPilot configuration. Copy to .env and adjust. Never commit a real .env.
# ---------------------------------------------------------------- storage & limits
FLOPILOT_DATA_DIR=./data
FLOPILOT_MAX_UPLOAD_MB=10
FLOPILOT_MAX_CELLS=500000
FLOPILOT_MAX_SHEETS=50
FLOPILOT_MAX_UNCOMPRESSED_MB=150
FLOPILOT_RETENTION_DAYS=30
FLOPILOT_LOG_WORKBOOK_CONTENT=false
# ---------------------------------------------------------------- auth
FLOPILOT_AUTH_MODE=demo
FLOPILOT_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# ---------------------------------------------------------------- LLM (optional; demo mode needs none)
FLOPILOT_LLM_PROVIDER=demo
# FLOPILOT_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
FLOPILOT_LLM_MODEL=claude-opus-5-5
FLOPILOT_LLM_EFFORT=medium
# Used only for the displayed cost ESTIMATE (USD per million tokens); check current pricing.
FLOPILOT_LLM_INPUT_COST_PER_MTOK=4.0
FLOPILOT_LLM_OUTPUT_COST_PER_MTOK=20.0
# ---------------------------------------------------------------- harness budgets
FLOPILOT_MAX_STEPS=8
FLOPILOT_MAX_TOKENS_PER_RUN=60000
FLOPILOT_MAX_COST_PER_RUN_USD=0.50
FLOPILOT_TOOL_TIMEOUT_S=30
FLOPILOT_MAX_TOOL_ROWS=50
# ---------------------------------------------------------------- formula verification
# auto = use LibreOffice if installed; none = never. Docker: FLOPILOT_INSTALL_LIBREOFFICE=true at build time.
FLOPILOT_RECALC_ENGINE=auto
FLOPILOT_RECALC_TIMEOUT_S=60
FLOPILOT_INSTALL_LIBREOFFICE=false

FLOPILOT_CHAT_RATE_PER_MIN=30
FLOPILOT_UPLOAD_RATE_PER_MIN=20
