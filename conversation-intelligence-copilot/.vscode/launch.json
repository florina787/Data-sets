{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (:8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Frontend: Vite (:5173)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite"],
      "console": "integratedTerminal"
    },
    {
      "name": "Backend: pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "justMyCode": false
    },
    {
      "name": "Data: prepare dataset",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.prepare_dataset",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env"
    }
  ],
  "compounds": [
    { "name": "Full stack (API + UI)", "configurations": ["Backend: FastAPI (:8000)", "Frontend: Vite (:5173)"], "stopAll": true }
  ]
}
