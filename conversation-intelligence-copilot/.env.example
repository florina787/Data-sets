# Copy to .env and fill in what you need. Never commit .env.

# Nothing here is required: with no key and no local model the app runs deterministically and says so.

# --- Which LLM to use (optional) ---
# local = Qwen on this machine (recommended). auto = downloaded local model -> Gemini key -> none. Or: gemini | none
LLM_PROVIDER=local

# --- Free local model (no key): `make install-local-llm && make llm-download` (~1.1 GB, CPU) ---
LOCAL_MODEL_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
LOCAL_MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
# LOCAL_MODEL_DIR=./data/models
LOCAL_N_CTX=8192
LOCAL_THREADS=4
LOCAL_MAX_OUTPUT_TOKENS=600
# Layers to offload to a GPU (-1 = all). Needs a CUDA/Metal build of llama-cpp-python; ignored on a CPU-only build.
LOCAL_N_GPU_LAYERS=-1
# Load the model (and the retrieval/intent indexes) in the background at startup, so the first question finds them warm.
LOCAL_PRELOAD=true
# Time budget for a model-written explanation. A call predicted not to fit is skipped; one that overruns is stopped.
# Either way the deterministic, evidence-backed narrative is returned with a governance note. 0 disables the budget.
EXPLANATION_TIMEOUT_SECONDS=20

# --- Gemini (optional) ---
GEMINI_API_KEY=
# true = Vertex AI express mode (Google Cloud keys whose project has the Vertex AI API enabled)
GEMINI_USE_VERTEX=false
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.1
GEMINI_REQUESTS_PER_MINUTE=10
GEMINI_MAX_CONCURRENCY=2
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_SECONDS=45
# Cost estimates only (USD per 1M tokens); set to your tier's prices.
GEMINI_INPUT_COST_PER_MTOK=0.30
GEMINI_OUTPUT_COST_PER_MTOK=2.50
LLM_ENABLED=true

# --- Labels used by analytics: rules (default) or gemini (after `make label`) ---
LABEL_SOURCE=rules

# --- Embeddings: auto tries sentence-transformers, falls back to local LSA ---
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# hybrid = MiniLM + LSA fused by reciprocal rank fusion; dense | lsa use one index
RETRIEVAL_MODE=hybrid
RRF_K=60
HYBRID_LSA_WEIGHT=0.15

# --- Paths (defaults shown; relative to the repository) ---
# DATABASE_PATH=./data/processed/analytics.duckdb
# MEMORY_DATABASE_PATH=./data/processed/memory.sqlite
# FAISS_INDEX_PATH=./data/indexes/conversations.faiss

# --- Behaviour ---
DATASET_MODE=original
# true also loads data/synthetic/ at `make prepare` (generated demo data, never used by default)
ENABLE_SYNTHETIC_DEMO=false
MIN_AGENT_CONVERSATIONS=3
SESSION_RETENTION_DAYS=30
ENABLE_LANGSMITH=false
# LANGSMITH_API_KEY=
