# Copy to .env for local overrides. Never commit real secrets.
APP_ENV=demo                       # demo | production (production disables the persona selector and demo reset)
LLM_MODE=deterministic             # deterministic | live
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=                 # placeholder; leave empty for credential-free startup
LLM_TOKEN_BUDGET_PER_CHANGE=60000
PREDICTION_MODE=synthetic_fixture  # real requires an authorized model adapter (unconfigured)
DEPLOYMENT_MODE=simulated          # real deployment adapter is unconfigured; external writes disabled
EVAL_EXECUTION=background
APPROVAL_TTL_HOURS=72
IMAGE_SANDBOX_ENABLED=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
