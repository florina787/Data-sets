            "type": "boolean",
            "title": "Rerun",
            "default": true
          },
          "wait": {
            "type": "boolean",
            "title": "Wait",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ClarifyBody"
      },
      "CreateCaseBody": {
        "properties": {
          "account_id": {
            "type": "string",
            "title": "Account Id"
          },
