# Copy to .env and adjust. NEVER commit real keys. All values below are placeholders.

# demo | production. Production disables persona login, seeding and reset, and
# requires an SSO identity provider (not implemented in this prototype).
APP_MODE=demo

# Server-side session signing secret. Must be changed outside local demos.
SESSION_SECRET=replace-with-a-long-random-string

# Database. Default (unset) is SQLite at backend/telecomresolve.db.
# DATABASE_URL=postgresql+psycopg://telecomresolve:password@localhost:5432/telecomresolve
# CHECKPOINT_URL defaults to DATABASE_URL (or backend/checkpoints.db for SQLite).
POSTGRES_PASSWORD=local-dev-only

# Generation: DEMO (deterministic, offline, default) | LIVE | HYBRID.
# LIVE/HYBRID make real server-side model calls; connectors stay SIMULATED here.
GENERATION_MODE=DEMO
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# LLM_API_KEY=sk-ant-placeholder        # server-side only; never sent to the browser
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1500
LLM_MAX_CONCURRENCY=4
LLM_CASE_TOKEN_BUDGET=40000
LLM_CIRCUIT_BREAKER_FAILURES=3
LLM_CIRCUIT_BREAKER_RESET_SECONDS=60
# Cost estimation: fill from the provider's published price list and record the date.
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
LLM_PRICING_CONFIGURED_ON=unset

# Synthetic policy thresholds (configurable; not any operator's policy)
DIAGNOSTIC_FRESHNESS_HOURS=24
MAX_EVIDENCE_ITERATIONS=2
MAX_INVESTIGATION_SECONDS=120
APPROVAL_TTL_MINUTES=60
RECOVERY_WINDOW_MINUTES=30
RECOVERY_MIN_SAMPLES=4
REPEAT_CONTACT_WINDOW_DAYS=30

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
