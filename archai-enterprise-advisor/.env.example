# ArchAI configuration. Copy to .env (git-ignored) and adjust.
# DEMO_MODE=true  -> deterministic engine only, zero LLM calls, no key needed (default).
# DEMO_MODE=false -> optional LLM narration of the (still deterministic) decision.
DEMO_MODE=true

# Your OWN key, only needed when DEMO_MODE=false. Never commit a real key.
ANTHROPIC_API_KEY=your_own_key_here

# Optional
# ARCHAI_LLM_MODEL=claude-sonnet-5-5
# ARCHAI_LOG_LEVEL=INFO
