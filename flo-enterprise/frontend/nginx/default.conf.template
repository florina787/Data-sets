# Rendered by the nginx image's envsubst at start-up. Upstream DNS is re-resolved (valid=10s) so API redeploys or
# replica changes never leave the UI pointing at a stale IP. NGINX_RESOLVER: 127.0.0.11 (Docker) or kube-dns IP (K8s).
server {
  listen 8080;
  server_tokens off;
  client_max_body_size 6m;
  resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
  set $flo_api ${FLO_API_UPSTREAM};
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self'" always;
  root /usr/share/nginx/html;
  location /api/ { proxy_pass $flo_api; proxy_set_header X-Request-ID $request_id; proxy_read_timeout 60s; }
  location /assets/ { expires 7d; add_header Cache-Control "public, immutable"; }
  location / { try_files $uri /index.html; }
}
