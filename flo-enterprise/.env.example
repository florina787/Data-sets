# Copy to .env. Every value has a safe demo default; NEVER reuse demo secrets outside a local demo.
FLO_ENV=development
FLO_DATABASE_URL=sqlite:///var/flo.db            # postgresql+psycopg://flo:flo@localhost:5432/flo
FLO_AUDIT_DATABASE_URL=                          # empty = separate SQLite file (dev) / same Postgres DB
FLO_REDIS_URL=                                   # redis://localhost:6379/0 ; empty = in-process cache
FLO_OPA_URL=                                     # http://localhost:8181 ; empty = embedded PDP (OPA-parity tested)
FLO_JWT_SECRET=change-me                         # mock IdP signing key (production: enterprise OIDC IdP)
FLO_JWT_TTL_SECONDS=1800
FLO_VAULT_KEY=                                   # Fernet key for the token vault (required in production)
FLO_MODEL_PROVIDER=mock                          # mock | bedrock (requires boto3 + AWS credentials; CA region enforced by policy)
FLO_BEDROCK_REGION=ca-central-1
LANGSMITH_API_KEY=                               # empty = local-fallback telemetry (no external calls)
LANGSMITH_PROJECT=flo-enterprise
FLO_MAX_CONCURRENT_WORKFLOWS=32
FLO_MAX_INFLIGHT=256
FLO_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
POSTGRES_PASSWORD=flo-demo
