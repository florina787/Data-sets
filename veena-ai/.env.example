# VEENA.AI backend settings. The desktop app sets all of these automatically;
# they matter only when running the backend by hand (python -m backend).

# Loopback only. Any non-loopback address is refused at startup.
VEENA_HOST=127.0.0.1
VEENA_PORT=8765
# Per-launch secret the client must send as "Authorization: Bearer <token>".
# Leave empty to generate a random one.
VEENA_TOKEN=
# Where the SQLite database and FAISS indexes live.
VEENA_DATA_DIR=
# Origins allowed to call the API from a browser context, comma separated.
VEENA_ALLOWED_ORIGINS=null,file://
VEENA_MAX_UPLOAD_MB=50
# Local Ollama server. Must be a loopback address.
OLLAMA_URL=http://127.0.0.1:11434
# Desktop app only: use this Python instead of the bundled backend / repo venv.
# VEENA_PYTHON=
# Desktop app only: keep all app data in this folder (portable / testing).
# VEENA_USER_DATA=
