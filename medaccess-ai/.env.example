# Copy to .env (git-ignored). Never commit real secrets. Every value here is optional for the demo.
ENVIRONMENT=demo                  # demo | development | test | staging | production
DATA_MODE=SYNTHETIC               # SYNTHETIC | PUBLIC_DISCOVERY | AUTHORIZED_LIVE
# DATABASE_URL=postgresql+psycopg://medaccess:<password>@localhost:5432/medaccess  (default: local SQLite)
# CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
# REDIS_URL=redis://localhost:6379/0

# Required (>=32 chars) in staging/production. In demo an ephemeral secret is generated per process.
JWT_SECRET=
# Required in staging/production. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Optional LLM (backend only - never exposed to the frontend). Without it the copilot is deterministic.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_ROUTER_MODEL=claude-haiku-5-5
LLM_EXPLAINER_MODEL=claude-sonnet-5-5

# Optional LangSmith tracing. Payloads are redacted before export.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medaccess-ai
# Do NOT enable without an approved privacy basis (rejected in staging/production):
LANGSMITH_ALLOW_RAW_PAYLOADS=false

OTEL_ENABLED=true
OTEL_CONSOLE_EXPORT=false
RATE_LIMIT_PER_MINUTE=120
POSTGRES_PASSWORD=medaccess-local-only
GRAFANA_ADMIN_PASSWORD=change-me-locally
