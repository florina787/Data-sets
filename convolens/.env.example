# Copy to .env and fill in only what you need. Never commit .env. Secrets are read by the backend only.

# ---- Connected analysis: Claude via the Anthropic API ...
MODEL_PROVIDER=none                  # none | anthropic | bedrock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ---- ... or via Amazon Bedrock (credentials from the standard AWS chain: env vars, profile or role)
BEDROCK_MODEL_ID=
AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
MODEL_MAX_TOKENS=1500
MODEL_TIMEOUT_S=60
MODEL_MAX_RETRIES=2

# ---- LangSmith tracing (off by default). Payloads are redacted before upload.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=convolens
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# ---- Retrieval (semantic search needs the optional 'embeddings' extra and a cached or downloadable model)
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- Kaggle (only if kagglehub asks for credentials)
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# ---- Ingestion and limits
SAMPLE_SIZE=3000
SAMPLE_SEED=20240601
MAX_CONVERSATION_MESSAGES=50
MAX_UPLOAD_MB=600
FLO_MAX_TOOL_CALLS=8
FLO_MAX_ITERATIONS=3
FLO_MAX_TOKENS_PER_REQUEST=24000
FLO_TIMEOUT_S=90
MIN_GROUP_SIZE=20

# Semantic search: "local" (sentence-transformers) or "gemini" (gemini-embedding-001; fill the cache first with
#   python -m app.ingestion.cli embed <dataset_id>)
EMBEDDING_PROVIDER=local
# GEMINI_EMBEDDING_MAX_REQUESTS=50
